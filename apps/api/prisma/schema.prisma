datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum AuthProvider {
  GOOGLE
  ORCID
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum SongStatus {
  DRAFT
  COMPLETED
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  passwordHash    String?
  emailVerified   DateTime?
  displayName     String?
  themePreference ThemePreference @default(SYSTEM)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  accounts Account[]
  sessions Session[]
  albums   Album[]
  songs    Song[]
  tags     Tag[]

  @@map("users")
}

model Account {
  id                String       @id @default(uuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id
  userId       String
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailToken {
  id        String         @id @default(uuid())
  email     String
  tokenHash String
  type      EmailTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([tokenHash])
  @@index([email])
  @@map("email_tokens")
}

model Album {
  id            String   @id @default(uuid())
  userId        String
  title         String
  description   String?
  coverImageKey String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs Song[]

  @@index([userId])
  @@map("albums")
}

model Song {
  id              String     @id @default(uuid())
  userId          String
  albumId         String?
  title           String     @default("Sans titre")
  content         String     @default("")
  status          SongStatus @default(DRAFT)
  isFavorite      Boolean    @default(false)
  positionInAlbum Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  album         Album?         @relation(fields: [albumId], references: [id], onDelete: SetNull)
  versions      SongVersion[]
  instrumentals Instrumental[]
  shareLinks    ShareLink[]
  voiceNotes    VoiceNote[]
  tags          SongTag[]

  @@index([userId])
  @@index([albumId])
  @@map("songs")
}

model SongVersion {
  id        String   @id @default(uuid())
  songId    String
  title     String
  content   String
  createdAt DateTime @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@map("song_versions")
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs SongTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model SongTag {
  songId String
  tagId  String

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([songId, tagId])
  @@map("song_tags")
}

model Instrumental {
  id              String   @id @default(uuid())
  songId          String
  title           String
  s3Key           String
  mimeType        String
  sizeBytes       Int
  durationSeconds Float?
  bpm             Int?
  musicalKey      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@map("instrumentals")
}

model ShareLink {
  id             String    @id @default(uuid())
  songId         String
  tokenHash      String    @unique
  expiresAt      DateTime?
  isRevoked      Boolean   @default(false)
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@map("share_links")
}

model VoiceNote {
  id              String   @id @default(uuid())
  songId          String
  s3Key           String
  durationSeconds Float?
  createdAt       DateTime @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@map("voice_notes")
}
