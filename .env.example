# ==============================================================================
# Verso — Configuration des variables d'environnement (Exemple)
# RÈGLE CONSTITUTIONNELLE : Ne jamais commiter de secrets ou de fichiers .env réels.
# ==============================================================================

# Environnement & Serveur
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173

# Base de données PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://verso:verso_dev_password@localhost:5432/verso"
# Alternative via socket local Unix :
# DATABASE_URL="postgresql://normanxcat@localhost/verso?host=/var/run/postgresql"

# Sessions utilisateur & Cookies HttpOnly (min. 32 caractères)
SESSION_SECRET="changez_ce_secret_en_production_par_un_secret_fort_de_32_caracteres"

# Stockage Audio compatible S3 (MinIO en local / Cloudflare R2 en prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=verso-audio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword

# OAuth Google (Optionnel en développement initial)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth ORCID (Optionnel en développement initial)
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
